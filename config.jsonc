{
    "layer": "top",
    "position": "bottom",
    "height": 36,
    "spacing": 6,
    
    "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
    ],
    
    "modules-center": [
    "clock"
    ],
    
    "modules-right": [
    "cpu",
    "memory",
    "disk",
    "network",
    "pulseaudio",
    "custom/updates",
    "custom/uptime",
    "tray"
    ],
    
    "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
    "default": "",
    "active": "",
    "urgent": ""
    },
    "persistent-workspaces": {
    "*": 5
    },
    "sort-by": "number",
    "tooltip": true
    },
    
    "hyprland/window": {
    "format": "{}",
    "max-length": 45,
    "separate-outputs": true,
    "tooltip": true
    },
    
    "clock": {
    "format": "  {:%H:%M}",
    "format-alt": "  {:%a, %d %b %Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    
    "cpu": {
    "interval": 2,
    "format": "  {usage}%",
    "format-icons": [
    "▁",
    "▂",
    "▃",
    "▄",
    "▅",
    "▆",
    "▇",
    "█"
    ],
    "tooltip-format": "CPU usage: {usage}%"
    },
    
    "memory": {
    "interval": 2,
    "format": "  {percentage}%",
    "tooltip-format": "RAM used: {used:0.1f} GiB / {total:0.1f} GiB ({percentage}%)"
    },
    
    "disk": {
    "interval": 30,
    "path": "/",
    "format": "󰋊  {percentage_used}%",
    "tooltip-format": "Root filesystem\nUsed: {used}\nAvailable: {free}\nTotal: {total}\nUsage: {percentage_used}%"
    },
    
    "network": {
    "interval": 2,
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀  {ifname}",
    "format-disconnected": "󰤮  offline",
    "tooltip-format": "{ifname}\nIP: {ipaddr}/{cidr}\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}",
    "tooltip-format-wifi": "{essid}\nIP: {ipaddr}/{cidr}\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}",
    "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}/{cidr}\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}"
    },
    
    "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  muted",
    "format-icons": {
    "default": [
    "",
    "",
    ""
    ]
    },
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "wpctl status",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
    "tooltip-format": "Volume: {volume}%\nLeft click: mute/unmute\nScroll: volume\nRight click: audio devices"
    },
    
    "custom/updates": {
    "interval": 1800,
    "exec": "sh -c 'n=$(checkupdates 2>/dev/null | wc -l); if [ \"$n\" -gt 0 ]; then echo \"󰏗  $n\"; else echo \"󰸟  0\"; fi'",
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "Arch Linux updates available\nClick to open update command",
    "exec-if": "command -v checkupdates",
    "on-click": "foot -e bash -c 'sudo pacman -Syu; echo; read -rp \"Press Enter to close...\"'"
    },
    
    "custom/uptime": {
    "interval": 30,
    "exec": "uptime -p | sed 's/up //'",
    "format": "󰔟  {}",
    "tooltip": true,
    "tooltip-format": "Machine Uptime"   
    },
    
    "tray": {
    "icon-size": 16,
    "spacing": 8
    }
}
